{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@cloudflare/workers-types",
      "vitest/globals",
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "worker/**/*.ts",
    "worker-tests/**/*.ts",
    "src/data/candidates.ts",
    "src/types/game.ts",
    "src/types/formalGame.ts",
    "vitest.worker.config.ts"
  ]
}
