{
  "name": "mindgame1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mind-game-formal",
      "database_id": "d8cd33bd-257a-4cba-aa6b-1d903e306c0c",
      "migrations_dir": "migrations"
    }
  ]
}
